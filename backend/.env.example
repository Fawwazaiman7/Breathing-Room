# Copy to .env for local development. On Render, enter the same names under
# Environment. Never commit real values.
PORT=3000
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx
GROQ_API_KEY=xxx
GEMINI_API_KEY=xxx
CHAT_MIN_SIMILARITY=0.60
# Browser origins allowed to call the API, comma-separated. Leave empty locally.
CORS_ORIGINS=
# Optional overrides:
# GROQ_MODEL=
# GROQ_REASONING_EFFORT=
# GEMINI_EMBEDDING_MODEL=
